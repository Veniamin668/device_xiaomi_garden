cc_binary {
    name: "aera-audio-bridge",
    recovery: true,
    srcs: ["aera_audio_bridge.cpp"],
    shared_libs: [
        "libcutils",
        "liblog",
    ],
    cpp_std: "c++17",
    cflags: [
        "-Wall",
        "-Wextra",
    ],
}
